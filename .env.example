# Database
DATABASE_URL=postgresql://postgres:codepop123@localhost:5432/codepop

# PostgreSQL root password (used by docker-compose)
POSTGRES_PASSWORD=codepop123

# ============================================================
# Webhook 自动增量同步密钥（部署者自己生成，请勿使用默认值）
# 生成方式：openssl rand -hex 16
# 这两个值只放在本地 .env（已被 .gitignore 忽略），不会提交到代码仓库，
# 因为项目是开源的，硬编码密钥等于公开，任何人都可伪造 push 事件触发索引。
# ============================================================

# GitHub：仓库 Settings → Webhooks → Add webhook → Secret 填这里（须与 .env 完全一致）
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Gitee：仓库管理 → WebHooks → 密码填这里（回调时以 X-Gitee-Token 请求头回传）
GITEE_WEBHOOK_TOKEN=your-gitee-token

# Embedding model (HuggingFace model name or local path)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
HF_ENDPOINT=https://hf-mirror.com

# Code storage directory
REPOS_DIR=./repos

# API configuration
API_HOST=0.0.0.0
API_PORT=8080

# Logging
LOG_LEVEL=INFO
